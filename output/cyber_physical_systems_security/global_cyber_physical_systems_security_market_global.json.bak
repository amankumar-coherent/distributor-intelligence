\n[69]: /blog\n[70]: /company\n[71]: /company/leadership\n[72]: /events\n[73]: /company/newsroom\n[74]: /company/careers\n[75]: /customer-stories\n[76]: /company/contact-us\n[77]: /demo\n[78]: /demo\n[79]: https://www.gartner.com/reviews/market/operational-technology-security/vendor/nozomi-networks\n[80]: /customer-testimonials\n[81]: /resources/whats-so-great-about-the-graph\n[82]: /resources/whats-so-great-about-the-graph\n[83]: /platform/vantage\n[84]: /blog/guide-to-iot-security\n[85]: /blog/guide-to-iot-security\n[86]: /resources/closing-iot-security-gaps-in-your-operations\n[87]: /resources/closing-iot-security-gaps-in-your-operations\n[88]: /demo\n[89]: /resources/nozomi-networks-platform-demo\n[90]: https://www.nozominetworks.com/legal/privacy-policy\n[91]: #\n[92]: https://www.linkedin.com/company/nozomi-networks-sa\n[93]: /demo\n[94]: /platform\n[95]: /platform/vantage\n[96]: /platform/central-management-console\n[97]: /platform/guardian\n[98]: /platform/guardian-air\n[99]: /platform/arc\n[100]: /platform/asset-intelligence\n[101]: /platform/threat-intelligence\n[102]: /platform/smart-polling\n[103]: /technology-alliance-ecosystem\n[104]: https://security.nozominetworks.com/\n[105]: /professional-services\n[106]: /professional-services/designated-engineer\n[107]: /professional-services/fast-track-service-packages\n[108]: /professional-services/health-check-service\n[109]: /professional-services/optimization-service\n[110]: /solutions/threat-detection-and-response\n[111]: /solutions/iot-ot-network-monitoring\n[112]: /solutions/iot-ot-asset-inventory-management\n[113]: /solutions/iot-ot-vulnerability-management\n[114]: /solutions/iot-security\n[115]: /solutions/data-center-cybersecurity\n[116]: /compliance/dow-zt-for-ot\n[117]: /compliance/isa-iec-62443-standards\n[118]: /compliance/nerc-cip\n[119]: /compliance/nis2-directive-compliance\n[120]: /compliance/sec-cybersecurity-rules\n[121]: /compliance/tsa-security-directives\n[122]: /industries/airport-cybersecurity\n[123]: /industries/electric-utilities-cybersecurity\n[124]: /industries/healthcare-cybersecurity\n[125]: /industries/federal-government\n[126]: /industries/manufacturing-cybersecurity\n[127]: /industries/maritime-cybersecurity\n[128]: /industries/mining-cybersecurity\n[129]: /industries/oil-gas-cybersecurity\n[130]: /industries/pharmaceutical-cybersecurity\n[131]: /industries/rail-cybersecurity\n[132]: /industries/retail-cybersecurity\n[133]: /industries/smart-cities-cybersecurity\n[134]: /industries/water-wastewater-cybersecuri"
