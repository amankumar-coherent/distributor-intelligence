          "people": {
            "leadership": [
              {
                "name": "Eli Chachak",
                "title": "Co-Founder, CTO",
                "bio": "Eli is founding partner of CyberDB. Prior to that Eli founded Stratechy, a Strategy Consulting firm specialized in helping management teams of Hi-Tech vendors in Cyber product strategy, Turn-around road-map as well as building and executing Go-to-market strategies. Among Stratechy\u2019s customers are leading corporates as Amdocs, Brother, Nice as well as tens of start-ups. Prior to Stratechy, Eli served as VP Business development and Marketing at cVidya and ECtel. Eli holds BSc. Computer Science and HTS-A Amsterdam, Netherlands and Executive MBA at Northwestern University- Chicago and Tel-Aviv University.",
                "linkedin": ""
              },
              {
                "name": "Ohad Kamer",
                "title": "Co-Founder, CMO",
                "bio": "Ohad is CyberDB's CMO, Co-Founder and a Board Member. Ohad brings more than 2 decades of experience in the telecom industry. Prior is also Co-founder and CMO at Atrinet, Ohad held senior positions within Nokia Solutions and Networks (NSN), including several years as the Head of Carrier Ethernet Transport (CET) Sales. Ohad holds an Executive MBA from Bar Ilan University and a B.Sc in Electronic and Computer Engineering.",
                "linkedin": ""
              },
              {
                "name": "Yotam Gutman",
                "title": "VP Marketing",
                "bio": "Yotam has over 10 years experience in sales and marketing roles with vendors in cyber, intelligence and defense security industries. Yotam has successfully managed the marketing and Business development efforts of several cybersecurity startups where he planned and executed the launch of the brand, managed partners and distribution channels and strategic alliances, media, analyst relations and customer acquisition.",
                "linkedin": ""
              },
              {
                "name": "Emilio Iasiello",
                "title": "Editor",
                "bio": "Emilio Iasiello has more than 12 years\u2019 experience as a strategic cyber intelligence analyst, supporting US government civilian and military intelligence organizations, as well as security companies in the private sector. He has delivered cyber threat presentations to domestic and international audiences and has published extensively in peer-reviewed journals.",
                "linkedin": ""
