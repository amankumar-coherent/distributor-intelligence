n[95]: /resources/implementing-insm-with-industrial-defender\n[96]: /resources/why-historical-data-matters-in-ot-security-compliance\n[97]: /resources/webinar-defending-against-attackers-who-use-ai-as-a-weapon\n[98]: /privacy-policy\n[99]: /ot-cyber-risk-management\n[100]: /cyber-diligence-service\n[101]: /copilot-service\n[102]: /professional-services\n[103]: /professional-services\n[104]: /professional-services\n[105]: /professional-services\n[106]: /solutions/ot-asset-management\n[107]: /solutions/vulnerability-management\n[108]: /solutions/security-event-monitoring\n[109]: /solutions/compliance-reporting\n[110]: /function/security\n[111]: /function/compliance\n[112]: /function/operations\n[113]: /function/executive\n[114]: /industries/building-automation\n[115]: /industries/chemical-processing-cybersecurity\n[116]: /industries/electric-utilities-cybersecurity\n[117]: /industries/federal-government\n[118]: /industries/food-agriculture\n[119]: /industries/maritime\n[120]: /industries/metals-mining\n[121]: /industries/oil-gas-cybersecurity\n[122]: /industries/pharmaceutical-cybersecurity\n[123]: /industries/rail\n[124]: /industries/water\n[125]: /resources\n[126]: /glossary\n[127]: /defendersphere-ics-vendors\n[128]: /it-ot-integration-lab\n[129]: /risk-assessment-calculator\n[130]: /innovations\n[131]: /glossary\n[132]: /about-us\n[133]: /how-we-compare\n[134]: /team\n[135]: /events\n[136]: /press\n[137]: /careers\n[138]: /contact-us"
