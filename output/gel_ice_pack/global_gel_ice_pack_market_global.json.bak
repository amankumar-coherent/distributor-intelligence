ce\":null\n,\"inventory_quantity\":24,\"inventory_management\":\"shopify\",\"inventory_policy\":\"deny\",\"barcode\":\"81903\n5027896\",\"featured_media\":{\"alt\":\"Freezable 12 Can Tote Cooler -\nPackIt#color_black\",\"id\":28686443675734,\"position\":28,\"preview_image\":{\"aspect_ratio\":1.0,\"height\":8\n00,\"width\":800,\"src\":\"\\/\\/packit.com\\/cdn\\/shop\\/files\\/freezable-12-can-tote-cooler-black-front.jpg\n?v=1776468552\"}},\"requires_selling_plan\":false,\"selling_plan_allocations\":[],\"quantity_rule\":{\"min\":\n1,\"max\":null,\"increment\":1}},{\"id\":44509426810966,\"title\":\"Blue Bouquet\",\"option1\":\"Blue\nBouquet\",\"option2\":null,\"option3\":null,\"sku\":\"PKT-TC-BBQ\",\"requires_shipping\":true,\"taxable\":true,\"f\neatured_image\":{\"id\":36678616612950,\"product_id\":7542180773974,\"position\":29,\"created_at\":\"2026-04-1\n7T15:17:55-07:00\",\"updated_at\":\"2026-04-17T16:29:29-07:00\",\"alt\":\"Freezable "
