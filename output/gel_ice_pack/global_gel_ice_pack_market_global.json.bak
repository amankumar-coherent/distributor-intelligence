            "products": [
              {
                "name": "Arctic Ice Variety 3-Pack",
                "category": "Cooler Packs",
                "description": "The ultimate cooling solution for every need. This variety pack includes one Alaskan ice pack for keeping food fresh, one Chilln Brew for beverage coolers, and one Tundra for frozen items like ice cream.",
                "features": [
                  "Includes Alaskan, Chilln Brew, and Tundra packs",
                  "Available in Large, XL, and XXL sizes"
                ],
                "target_customers": "Families, outdoor enthusiasts, anyone needing reliable cooling solutions",
                "pricing": "From $59.99"
              },
              {
                "name": "Lunch Box Sample Pack",
                "category": "Cooler Packs",
                "description": "Discover our smaller ice packs with this convenient lunch box sample pack. Choose your size\u2014Small (.75 lbs) or Medium (1.5 lbs)\u2014and receive one Alaskan and one Chillin' Brew ice pack.",
                "features": [
                  "Includes Alaskan and Chillin' Brew packs",
                  "Ideal for lunch boxes and on-the-go cooling needs"
                ],
                "target_customers": "Individuals looking for portable cooling solutions",
                "pricing": "From $24.99"
              },
              {
                "name": "Arctic Ice Bundle Pack",
                "category": "Cooler Packs",
                "description": "Discover the complete Arctic Ice collection with our versatile Bundle Packs. Choose from three innovative cooling series: the Chillin Brew series, the Alaskan Series, and the Tundra Series.",
                "features": [
                  "Includes multiple size options",
                  "Customizable cooling strategy for any adventure"
                ],
                "target_customers": "Outdoor enthusiasts, families",
                "pricing": "From $115.99"
              },
              {
                "name": "Arctic Ice Bulk Pack",
                "category": "Cooler Packs",
                "description": "Stock up and save with Arctic Ice bulk packs featuring three distinct cooling solutions. Choose Chillin Brew for beverages, Alaskan Series for food-safe cooling, or Tundra Series for extreme cold.",
                "features": [
                  "Available in five bulk sizes",
                  "Reusable ice packs"
                ],
                "target_customers": "Businesses, outdoor enthusiasts, families",
                "pricing": "From $120.00"
              },
              {
                "name": "Chillin' Brew\u00ae 2 Packs",
                "category": "Ice Packs",
                "description": "Ice packs designed to keep beverages colder than ice, powered by a non-toxic formula that freezes at 28\u00b0F (-2\u00b0C).",
                "features": [
                  "28\u00b0 Beer Cave Cold",
                  "Rugged UV Stabilized Color Container",
                  "Non Toxic",
                  "Reusable",
                  "Maximum Surface Area for Faster Cooling",
                  "Leak Proof Ultra Sonic Spin Welded Cap",
                  "Limited Lifetime Warranty",
                  "Made in the USA"
                ],
                "target_customers": "Outdoor enthusiasts, campers, and anyone needing to keep beverages cold.",
                "pricing": "$27.99 - $85.99"
              },
              {
                "name": "Chillin' Cradle\u00ae",
                "category": "Ice Packs",
                "description": "Designed to maximize surface area contact with bottles or cans, keeping drinks colder longer without the hassle of ice.",
                "features": [
                  "Top-rack dishwasher safe",
                  "Customizable with end caps and dividers",
                  "Flat storage in freezer",
                  "Dimensions: 8.7 x 11 x 2 inches"
                ],
                "target_customers": "Consumers looking for an efficient way to keep drinks cold in coolers.",
                "pricing": "$65.99 - $131.99"
              },
              {
                "name": "Tundra Series\u00ae 2 Packs",
                "category": "Ice Packs",
                "description": "Ice packs that maintain a freezer-like temperature to keep frozen items frozen for extended periods.",
                "features": [
                  "5 Degree Cooling Point",
                  "Non Toxic",
                  "Reusable",
                  "Maximum Surface Area for Faster Cooling",
                  "Leak Proof Ultra Sonic Spin Welded Cap",
                  "Limited Lifetime Warranty",
                  "Made in the USA"
                ],
                "target_customers": "Outdoor enthusiasts, campers, and anyone needing to keep frozen items cold.",
                "pricing": "$42.99 - $85.99"
              },
              {
                "name": "Chillin Disc\u00ae",
                "category": "Ice Packs",
                "description": "Turns any bucket into a cooler for several hours of ice-cold beverages and food.",
                "features": [
                  "Dishwasher safe",
                  "Freezes easily overnight",
                  "Can be used in any cooler"
                ],
                "target_customers": "Consumers looking for a simple solution to keep food and drinks cold.",
                "pricing": "$24.99"
              }
            ],
