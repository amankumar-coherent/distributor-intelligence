          "company": {
            "name": "Arctic Ice",
            "legal_name": "Arctic Ice, LLC",
            "description": "Arctic Ice\u00ae cooler packs are the most durable, versatile, and effective cooler packs available. Made from non-toxic, high-performance phase-change materials (PCM), Arctic Ice\u00ae can keep your cooler temperatures anywhere from ice cold to frozen.",
            "tagline": "Keep your cooler contents cool, cold or even frozen.",
