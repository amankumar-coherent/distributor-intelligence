              "Scientific Research",
              "Research and Development",
              "Defense",
              "Basic Science"
            ],
            "key_markets": [
              "United States",
              "North America",
              "Global"
            ],
            "products": [
              {
                "name": "Laser Glass",
                "category": "Material",
                "description": "Neodymium-doped phosphate glass used to amplify laser light for high-energy experiments.",
                "features": [
                  "High optical quality",
                  "Continuous melting process",
                  "20 times faster production"
                ],
                "target_customers": "Research institutions and government agencies",
                "pricing": ""
              },
              {
                "name": "Optical Switch",
                "category": "Component",
                "description": "Plasma electrode Pockels cell used to control laser beam paths in the amplifier.",
                "features": [
                  "Allows multiple passes of laser beams",
                  "Unique plasma electrode design",
                  "Uniform switching across large beams"
                ],
                "target_customers": "Research institutions and government agencies",
                "pricing": ""
              },
              {
                "name": "Preamplifier Modules",
                "category": "Component",
                "description": "Modules that amplify the laser pulse before it enters the main amplifier.",
                "features": [
                  "High efficiency",
                  "Designed for NIF's specific requirements"
                ],
                "target_customers": "Research institutions and government agencies",
                "pricing": ""
              },
              {
                "name": "Target Fabrication",
                "category": "Service",
                "description": "Fabrication of targets for experiments in fusion and high energy density science.",
                "features": [
                  "Precision engineering",
                  "Custom target designs"
                ],
                "target_customers": "Research institutions and government agencies",
                "pricing": ""
              },
              {
                "name": "Preamplifier Modules",
                "category": "Laser Technology",
                "description": "Modules that amplify low-energy laser pulses for use in high-energy laser systems.",
                "features": [
                  "Amplifies pulse energy by a factor of 10 billion",
                  "Includes regenerative amplifiers and four-pass relay imaging laser amplifiers",
                  "Precision beam shaping capabilities"
                ],
                "target_customers": "Research institutions and defense applications",
                "pricing": ""
              },
              {
                "name": "Deformable Mirrors",
                "category": "Optical Technology",
                "description": "Adaptive optics that correct wavefront errors in laser beams to improve focus and intensity.",
                "features": [
                  "Uses an array of actuators to bend its surface",
                  "Corrects optical distortion",
                  "Achieves spot sizes of about 100 microns or smaller"
                ],
                "target_customers": "Research institutions and defense applications",
                "pricing": ""
              },
              {
                "name": "Rapid-Growth Crystals",
                "category": "Optical Materials",
                "description": "Large single crystals used for polarization rotation and frequency conversion in laser systems.",
                "features": [
                  "KDP and DKDP crystals for laser optics",
                  "Rapid growth technology reduces production time",
                  "High optical quality for laser applications"
                ],
                "target_customers": "Research institutions and defense applications",
                "pricing": ""
              },
              {
                "name": "Computer Control System",
                "category": "Control Technology",
                "description": "A sophisticated system that manages the alignment and firing of laser beams with high precision.",
                "features": [
                  "Over 66,000 control points",
                  "More than 2,000 computers running 5 million lines of code",
                  "Automated shot countdown sequences"
                ],
                "target_customers": "Research institutions and defense applications",
                "pricing": ""
              },
              {
                "name": "Target Fabrication",
                "category": "Engineering",
                "description": "Precision engineering and fabrication of targets for laser experiments.",
                "features": [
                  "Machined to within 1 micron accuracy",
                  "Components as small as 100 nanometers",
                  "Smoothness tolerance approaching 1 nanometer"
                ],
                "target_customers": "Research institutions and defense applications",
                "pricing": ""
              },
              {
                "name": "Power Conditioning System",
                "category": "Laser Technology",
                "description": "Stores approximately 400 megajoules of electrical energy for each NIF shot and drives the 7,680 flashlamps located in the NIF laser\u2019s main and power amplifiers.",
                "features": [
                  "Stores 400 megajoules of energy",
                  "Drives 7,680 flashlamps",
                  "Delivers nearly 330 million joules of electrical energy on each shot",
                  "Operated by a single operator using a custom integrated software control system"
                ],
                "target_customers": "Research institutions, government agencies, and defense organizations.",
                "pricing": ""
              },
              {
                "name": "Injection Laser System",
                "category": "Laser Technology",
                "description": "Responsible for generating a prescribed temporal and spatial pulse shape, adjusting the energy in each of the 192 beams, and adjusting the time when the beams hit the target.",
                "features": [
                  "Generates low-energy laser pulses",
                  "Adjusts energy and timing for 192 beams",
                  "Includes Master Oscillator Room and Preamplifier Module"
                ],
                "target_customers": "Research institutions, government agencies, and defense organizations.",
                "pricing": ""
              },
              {
                "name": "Amplifiers",
                "category": "Laser Technology",
                "description": "Amplifies the weak input pulse from the injection laser system to provide the necessary power and energy for the NIF experiments.",
                "features": [
                  "Uses neodymium-doped phosphate glass slabs",
                  "Surrounds amplifiers with flashlamps for optical gain",
                  "Occupies approximately one-fourth of the facility\u2019s floor space"
                ],
                "target_customers": "Research institutions, government agencies, and defense organizations.",
                "pricing": ""
              },
              {
                "name": "Final Optics Assemblies",
                "category": "Laser Technology",
                "description": "The last element of the main laser system that conditions and focuses the laser beams before they reach the target.",
                "features": [
                  "Converts laser light to shorter wavelengths",
                  "Provides beam conditioning and debris shielding",
                  "Allows for beam smoothing and power measurement"
                ],
                "target_customers": "Research institutions, government agencies, and defense organizations.",
                "pricing": ""
              },
              {
                "name": "Laser Systems",
                "category": "High Energy Density Science",
                "description": "A complex system of 192 high-powered lasers designed for fusion ignition experiments.",
                "features": [
