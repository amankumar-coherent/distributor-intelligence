          "business": {
            "industries": [
              "Medical & Healthcare",
              "Defense & Aerospace",
              "Industrial & Manufacturing",
              "Research & Biophotonics"
            ],
            "key_markets": [],
            "products": [
              {
                "name": "JenLas D2",
                "category": "DPSS Laser",
                "description": "High-Power Diode-Pumped Thin Disk Lasers, available in 532nm or 1064nm, up to 8W.",
                "features": [
                  "Highest efficiency in the industry",
                  "Proven with over 25k fielded",
                  "High-quality & precision",
                  "Peltier cooling \u2013 water-free",
                  "Compact & easy integration",
                  "Multiple levels of integration"
                ],
                "target_customers": "OEM integrators, researchers, and applications specialists",
                "pricing": ""
              },
              {
                "name": "JenLas Fiber ns",
                "category": "Fiber Laser",
                "description": "100W Nanosecond Fiber Laser, 1085nm, up to 1.1mJ, up to 200kHz.",
                "features": [
                  "Rugged & industry-proven",
                  "Back reflection protection",
                  "Designed for industrial use",
                  "Complete control by software, hardwired, or mixed",
                  "Variable rep. rate & pulse width",
                  "On-axis guiding laser",
                  "Air or water cooling",
                  "Optional add-on optical components"
                ],
                "target_customers": "OEM integrators, researchers, and applications specialists",
                "pricing": ""
              },
              {
                "name": "JDL-Unmounted Bars",
                "category": "Laser Diode",
                "description": "High-power unmounted laser diode bars in the 760-1070 nm spectral region, up to 300W CW/500W QCW.",
                "features": [
                  "Full customization starting from the epitaxial level",
                  "Emitter configuration & cavity length options",
                  "Options for Low fill factor, high-power CW & hard-pulse or QCW & long-pulse operation",
                  "High reliability & long lifetime"
                ],
                "target_customers": "OEM integrators, industrial applications",
                "pricing": ""
              },
              {
                "name": "JOLD-Stacks",
                "category": "Laser Diode",
                "description": "High-Power Laser Diode Stacks, multimode, up to 2400W.",
                "features": [
                  "Scalable output power up to 2400W",
                  "CW & QCW configurations",
                  "High reliability & long lifetime",
                  "FAC or FAC/SAC collimation lensing options",
                  "Passive & active cooling options",
                  "Fully customizable solutions"
                ],
                "target_customers": "OEM integrators, industrial applications",
                "pricing": ""
              },
              {
                "name": "RVBG: Stabilized Laser Diode",
                "category": "Laser Diode",
                "description": "A wavelength-stabilized single-mode or multimode laser diode that offers a narrow linewidth output in wavelengths from 633nm to 1064nm, with output powers up to 1.5W.",
                "features": [
                  "High Power Single Frequency Output",
                  "Ultra-Narrow Spectral Linewidth",
                  "Stabilized Output Spectrum (< 0.007 nm/0C)",
                  "Gaussian TEM00 Spatial Mode",
                  "Circularized & Collimated Output Beam",
                  "Integral ESD Protection & Thermistor",
                  "SMSR 70 dB w/ laser line filter (40 dB without)",
                  "Integral Laser Line Filter"
                ],
                "target_customers": "Industrial, Medical, Research",
                "pricing": ""
              },
              {
                "name": "neoVAN",
                "category": "DPSS Amplifier",
                "description": "DPSS Amplifier, CW to ps Pulsed, 1064 nm, 0-40 dBm input, 5-100 W output, up to 5 mJ.",
                "features": [
                  "Wavelength: 1064nm",
                  "Output Power: 5 \u2013 100W",
                  "Pulse Energy: Up to 5mJ",
                  "Mode of Operation: CW to ps pulses",
                  "Beam Quality: TEM00 / M\u00b2"
                ],
                "target_customers": "Industrial, Medical, Research",
                "pricing": ""
              },
              {
                "name": "neoMOS",
                "category": "DPSS Laser",
                "description": "DPSS Laser, ps/fs Pulsed, 1064nm, up to 100W, up to 500\u00b5J, up to 80MHz.",
                "features": [
                  "Customizable Parameters",
                  "Ultra-compact footprint",
                  "Highly flexible & scalable design",
