          "company": {
            "name": "National Ignition Facility",
            "legal_name": "Lawrence Livermore National Laboratory",
            "description": "The National Ignition Facility (NIF) is the world\u2019s highest-energy laser system, designed to achieve fusion ignition and support national security through the National Nuclear Security Administration\u2019s Stockpile Stewardship Program.",
            "tagline": "Achieving Fusion Ignition for National Security and Energy Future",
            "founded_year": 2005,
            "website": "https://lasers.llnl.gov",
            "ticker": "",
            "type": "Government",
            "stock_exchange": "",
            "regulatory_status": "Operated by the Lawrence Livermore National Security, LLC for the Department of Energy's National Nuclear Security Administration"
          },
          "location": {
            "headquarters": "7000 East Avenue, Livermore, CA 94550",
            "offices": [],
            "countries": [
              "United States"
            ],
            "manufacturing_locations": [],
