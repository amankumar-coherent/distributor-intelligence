      "is_seed": true,
      "company_function": "",
      "company_summary": "L3Harris Technologies is a leading provider of advanced technology solutions, specializing in defense, public safety, aviation, and space systems. The company delivers a wide range of products and services, including airborne early warning and control systems, autonomous vehicles, and integrated intelligence solutions, aimed at supporting the civil and military objectives of nations, particularly in India. With a commitment to innovation and operational readiness, L3Harris plays a crucial role in enhancing national security and defense capabilities.",
      "operational_presence": "Markets mentioned on website: India",
      "data_sources": "discovery=phase1_seed | enrichment=smart_crawl | fetch=ddgs_extract_fallback | page=https://l3harris.com/",
      "_crawl": {
        "founded_year": 2019,
        "headquarters": "Melbourne, Florida, USA",
        "contact_address": "",
        "offices": "Colorado Springs, Colorado; Dallas, Texas; San Diego, California; Rochester, New York",
        "manufacturing_locations": "",
