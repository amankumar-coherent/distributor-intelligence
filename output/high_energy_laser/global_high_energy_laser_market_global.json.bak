            "name": "RPMC Lasers, Inc.",
            "legal_name": "RPMC Lasers, Inc.",
            "description": "RPMC Lasers is a trusted OEM laser partner providing high-quality laser solutions, including off-the-shelf lasers and fully customized designs.",
            "tagline": "The Lasers You Need from the People You Trust",
            "founded_year": 1994,
            "website": "https://www.rpmclasers.com",
            "ticker": "",
            "type": "Private",
            "stock_exchange": "",
