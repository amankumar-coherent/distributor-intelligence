        "contact_person": "Annie Lu",
        "contact_role": "CEO & Co-Founder",
        "email": "hello@runlaminar.com",
        "phone": "(617) 741-7384",
        "linkedin": "",
        "website": "https://runlaminar.com",
        "industries": "Food & Beverage; Flavor & Fragrance; Brewing; Health & Beauty; Consumer Packaged Goods",
        "products": "Clean-in-Place Optimization, Product Changeover Optimization, Batch & Line Optimization, Real-time Quality Analysis",
        "certifications": "FDA-compliant; BPE (Bioprocessing Equipment) certified",
        "distributors": "",
