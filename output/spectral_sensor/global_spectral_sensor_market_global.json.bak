      "discovery_source": "ddgs_bing",
      "enrichment_source": "smart_crawl",
      "website": "precisionoptical.com",
      "is_seed": false,
      "company_function": "manufacturer",
      "company_summary": "Precision Optical is a leading manufacturer specializing in custom prisms and optical assemblies, leveraging advanced technology to deliver precision-engineered solutions for the Defense, Aerospace, Biomedical, and Semiconductor industries. In addition to its core products, the company offers a range of services including CNC machining, optical coatings, and metrology, catering to manufacturers and developers in optics and related fields.",
      "operational_presence": "Some of our longest and most reliable commercial programs are based in Metrology, and we plan on that never changing!",
      "data_sources": "discovery=ddgs_bing | enrichment=smart_crawl | page=https://www.precisionoptical.com/about-us/education-and-outreach/",
      "_crawl": {
        "founded_year": 1959,
        "headquarters": "Costa Mesa, CA, USA",
        "contact_address": "320 Kalmus Drive, Costa Mesa, CA 92626, USA",
        "offices": "",
        "manufacturing_locations": "Costa Mesa, CA",
