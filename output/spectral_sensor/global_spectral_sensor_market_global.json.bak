      "is_seed": false,
      "company_function": "vendor",
      "company_summary": "CB Insights is a private market intelligence platform that delivers data and insights on private companies, investors, and market trends. Its core offerings include a suite of predictive AI tools, such as the Strategy Terminal and mobile app, designed for corporate strategy and deal teams, as well as comprehensive data services like advanced human-led research and API integrations. Targeting venture capitalists, corporate strategists, and businesses seeking market insights, CB Insights empowers its clients with actionable intelligence to drive informed decision-making.",
      "operational_presence": "Not stated on website",
      "data_sources": "discovery=ddgs_bing | enrichment=smart_crawl | page=https://www.cbinsights.com/about/revenue-operations/",
      "_crawl": {
        "founded_year": 2010,
        "headquarters": "New York, NY, USA",
        "contact_address": "498 Seventh Avenue 12th floor, New York, NY 10018, United States",
        "offices": "",
        "manufacturing_locations": "",
