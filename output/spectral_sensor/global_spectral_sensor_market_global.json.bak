      },
      "discovery_source": "ddgs_bing",
      "enrichment_source": "smart_crawl+search_backfill",
      "website": "amphenol-sensors.com",
      "is_seed": false,
      "company_function": "distributor",
      "company_summary": "Amphenol Sensors is a leading provider of a diverse range of sensing solutions, encompassing 25 specialized brands that deliver advanced technologies in pressure, temperature, vibration, and gas sensing, among others. The company serves a variety of markets, including automotive, medical, aerospace, and industrial applications, offering reliable and innovative products designed to transform complex analog signals into precise digital outputs. With a commitment to engineering excellence, Amphenol Sensors supports critical applications from healthcare to heavy equipment, ensuring high performance and durability in demanding environments.",
      "operational_presence": "Not stated on website",
      "data_sources": "discovery=ddgs_bing | enrichment=smart_crawl | fetch=ddgs_extract_fallback | page=https://amphenol-sensors.com/",
      "_crawl": {
        "founded_year": 1990,
        "headquarters": "Wallingford, CT, USA",
        "contact_address": "",
        "offices": "",
        "manufacturing_locations": "",
        "regions_served": "",
        "countries": "",
        "ownership_parent": "",
        "company_type": "",
        "employee_count": "100-500",
        "revenue": "$100M",
        "key_numbers": "",
        "contact_person": "",
        "contact_role": "",
