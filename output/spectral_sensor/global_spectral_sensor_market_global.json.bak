        "key_numbers": "",
        "contact_person": "Sanjay Kumar",
        "contact_role": "Founder & CEO",
        "email": "info@geospatialworld.net",
        "phone": "",
        "linkedin": "https://www.linkedin.com/company/geospatial-media-and-communications/",
        "website": "https://geospatialworld.net",
        "industries": "Government and Public Administration; Architecture Engineering and Construction (AEC); Banking; Financial Services; Insurance; Real Estate; Supply Chain; Logistics; Environmental Conservation; Sustainable Development",
        "products": "Geospatial World Forum; GeoSmart India; GeoBuiz Summit; Syndicate Reports; Geospatial Resource Platform; Consulting Services; Policy and Strategy Advocacy; GW Prime Live; GW Media Website",
        "certifications": "",
