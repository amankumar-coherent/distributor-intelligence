3\u5b9a\u4e86\u5728\u540c\u4e00\u5de5\u4f5c\u8ddd\u79bb\u4e0b\uff0c\u76f8\u673a\u80fd\u201c\u770b\n\u5230\u201d\u591a\u5927\u7684\u8303\u56f4\u4ee5\u53ca\u591a\u7ec6\u7684\u7ec6\u8282\u3002l\u77ed\u7126\u8ddd\uff1a\u77ed\u7126\u8ddd\u955c\u5934\u7684\u6838\u5fc3\u4f18\u52bf\u662f\u8986\u76d6\u8303\u56f4\u5e7f\u3001\u68c0\u6d4b\u6548\u7387\u9ad8\uff0c\u9002\u5408\u9700\u8981\u201c\u4e00\u773c...\n][52]\n[ \u65b0\u95fb ][53]\n[\n][54]\n[\n\n#### \u6d3b\u7ec6\u80de\u4e2d\u7684\u8102\u8d28\u5206\u8fa8\uff1a\u9ad8\u5149\u8c31\u4e2d\u7ea2\u5916\u5149\u58f0\u663e\u5fae\u955c\u7684\u65b0\u7a81\u7834\n\n2026-05-25\n\u8102\u8d28\u4e0d\u4ec5\u662f\u7ec6\u80de\u819c\u7684\u7ed3\u6784\u6210\u5206\u548c\u80fd\u91cf\u50a8\u5b58\u5206\u5b50\uff0c\u66f4\u4e0e\u764c\u75c7\u3001\u80a5\u80d6\u3001\u7cd6\u5c3f\u75c5\u3001\u5fc3\u8840\u7ba1\u75be\u75c5\u53ca\u795e\u7ecf\u9000\u884c\u6027\u75be\u75c5\u7684\u53d1\u751f\u53d1\n\u5c55\u5bc6\u5207\u76f8\u5173\u3002\u7136\u800c\uff0c\u5728\u6d3b\u7ec6\u80de\u4e2d\u76f4\u63a5\u89c2\u5bdf\u548c\u533a\u5206\u4e0d\u540c\u79cd\u7c7b\u7684\u8102\u8d28\uff0c\u957f\u671f\u4ee5\u6765\u9762\u4e34\u7740\u6280\u672f\u6311\u6218\u3002\u4f20\u7edf\u7684\u8367\u5149\u6807\u8bb0\u65b9\u6cd5\n\u53d7\u9650\u4e8e\u6807\u8bb0\u6548\u7387\u3001\u7279\u5f02\u6027\u548c\u5bf9\u7ec6\u80de\u529f\u80fd\u7684\u6f5c\u5728\u5e72\u6270\uff0c\u800c\u65e0\u6807\u8bb0\u7684\u5149\u5b66\u6280\u672f\u5f80\u5f80\u96be\u4ee5\u533a\u5206\u5316\u5b66\u7ed3\u6784\u76f8\u4f3c\u7684\u8102\u8d28\u5206\u5b50\u3002\n\u300a\u81ea\u7136-\u65b9\u6cd5\u300b\uff08Nature Methods\uff09\u53d1\u8868\u4e86\u4e00\u9879\u7814\u7a76\uff0c\u4ecb\u7ecd\u4e86\u4e00\u79cd\u540d\u4e3a\u201c\u9ad8\u5149\u8c31\u6307\u7eb9\u533a\u5149\u58f0...\n][55]\n[ \u65b0\u95fb ][56]\n\u5c55\u5f00\u66f4\u591a\n\u884c\u4e1a\u5e94\u7528\n[\n][57]\n[\n\n#### \u9ad8\u5149\u8c31\u6210\u50cf\u6280\u672f\u79d1\u666e\uff1a\u539f\u7406\u3001\u4f18\u52bf\u4e0e\u5de5\u4e1a\u5e94\u7528\u9886\u57df\n\n2026-06-25\n\u5728\u4f20\u7edf\u6210\u50cf\u6280\u672f\u53ea\u80fd\u6355\u6349\u7269\u4f53\u5916\u89c2\u8272\u5f69\u7684\u4eca\u5929\uff0c\u9ad8\u5149\u8c31\u6210\u50cf\u6280\u672f\u51ed\u501f \u201c\u56fe\u8c31\u5408\u4e00\u201d\n\u7684\u72ec\u7279\u80fd\u529b\uff0c\u6b63\u5728\u5de5\u4e1a\u68c0\u6d4b\u3001\u519c\u4e1a\u76d1\u6d4b\u3001\u751f\u6001\u73af\u4fdd\u7b49\u591a\u4e2a\u9886\u57df\u53d1\u6325\u91cd\u8981\u4f5c\u7528\u3002\u5b83\u4e0d\u4ec5\u80fd\u770b\u5230\u7269\u4f53\u7684\u8868\u9762\u5f62\u6001\uff0c\u8fd8\u80fd\n\u901a\u8fc7\u5149\u8c31\u4fe1\u606f\u8bc6\u522b\u7269\u8d28\u6210\u5206\u3001\u53d1\u73b0\u8089\u773c\u4e0d\u53ef\u89c1\u7684\u5185\u90e8\u7f3a\u9677\uff0c\u4e3a\u5404\u884c\u5404\u4e1a\u63d0\u4f9b\u4e86\u5168\u65b0\u7684\u89c2\u6d4b\u7ef4\u5ea6\u3002\u4e00\u3001\u9ad8\u5149\u8c31\u6210\u50cf\u7684\n\u57fa\u672c\u539f\u7406\u666e\u901a\u76f8\u673a\u53ea\u80fd\u8bb0\u5f55\u7ea2\u3001\u7eff\u3001\u84dd\u4e09\u4e2a\u6ce2\u6bb5\u7684\u5149\u5f3a\u4fe1\u606f\uff0c\u8f93\u51fa\u7684\u662f\u4eba\u773c\u53ef\u89c1\u7684\u5f69\u8272\u56fe\u50cf\u3002\u591a\u5149\u8c31\u76f8\u673a\u901a\u5e38\u6709\u51e0\n\u4e2a\u5230\u51e0\u5341\u4e2a\u6ce2\u6bb5\uff0c\u800c...\n][58]\n[ \u5e94\u7528 ][59]\n[\n][60]\n[\n\n#### \u591a\u5149\u8c31\u76f8\u673a\u79d1\u666e\u4e0e\u6027\u4ef7\u6bd4\u9009\u62e9\u6307\u5357\n\n2026-06-25\n\u5728\u5149\u8c31\u6210\u50cf\u6280\u672f\u5feb\u901f\u53d1\u5c55\u7684\u4eca\u5929\uff0c\u591a\u5149\u8c31\u76f8\u673a\u51ed\u501f\u5176\u5bf9\u7269\u4f53\u5149\u8c31\u7279\u5f81\u7684\u7cbe\u51c6\u6355\u6349\u80fd\u529b\uff0c\u5728\u519c\u4e1a\u3001\u73af\u4fdd\u3001\u5de5\u4e1a\u7b49\u591a\u4e2a\n\u9886\u57df\u5f97\u5230\u5e7f\u6cdb\u5e94\u7528\u3002\u5bf9\u4e8e\u9700\u8981\u91c7\u8d2d\u8fd9\u7c7b\u8bbe\u5907\u7684\u7528\u6237\u6765\u8bf4\uff0c\u5982\u4f55\u5728\u4f17\u591a\u4ea7\u54c1\u4e2d\u627e\u5230\u6027\u4ef7\u6bd4\u5408\u9002\u7684\u9009\u62e9\uff0c\u6210\u4e3a\u4e00\u4e2a\u91cd\u8981\n\u95ee\u9898\u3002\u672c\u6587\u5c06\u4ece\u79d1\u666e\u89d2\u5ea6\u4ecb\u7ecd\u591a\u5149\u8c31\u76f8\u673a\u7684\u6838\u5fc3\u77e5\u8bc6\uff0c\u5e76\u7ed3\u5408\u5b9e\u9645\u5e94\u7528\u573a\u666f\uff0c\u63a2\u8ba8\u5f69\u8c31\u79d1\u6280\u7684\u591a\u5149\u8c31\u76f8\u673a\u4ea7\u54c1\u5728\u6027\n\u4ef7\u6bd4\u65b9\u9762\u7684\u7279\u70b9\u3002\u4e00\u3001\u591a\u5149\u8c31\u76f8\u673a\u7684\u57fa\u672c\u539f\u7406\u4e0e\u4ef7\u503c\u591a\u5149\u8c31\u76f8\u673a\u662f\u4e00\u79cd\u80fd\u591f\u540c\u65f6\u91c7\u96c6\u76ee\u6807\u7269\u4f53\u5728\u591a\u4e2a\u79bb\u6563\u5149...\n][61]\n[ \u5e94\u7528 ][62]\n[\n][63]\n[\n\n#### \u770b\u4e0d\u89c1\u7684\u75d5\u8ff9\uff0c\u770b\u5f97\u89c1\u7684\u5149\u8c31\u8bc1\u636e\uff5c\u9ad8\u5149\u8c31\u6210\u50cf\u8d4b\u80fd\u6cd5\u533b\u996e\u54c1\u75d5\u91cf\u7269\u8bc1\u667a\u80fd\u8bc6\u522b\n\n2026-06-24\n\u524d\u8a00\u6848\u53d1\u73b0\u573a\u968f\u5904\u53ef\u89c1\u5496\u5561\u3001\u679c\u6c41\u3001\u9152\u6c34\u7c7b\u996e\u54c1\u5fae\u91cf\u6c61\u6e0d\uff0c\u4f9d\u9760\u8089\u773c\u5f88\u96be\u8fa8\u522b\u79cd\u7c7b\u3002\u4f20\u7edf\u68c0\u6d4b\u591a\u4f9d\u9760\u53d6\u6837\u3001\u5316\u5b66\u663e\n\u8272\u5904\u7406\uff0c\u5bb9\u6613\u635f\u4f24\u7269\u8bc1\uff0c\u4e0d\u5229\u4e8e\u540e\u7eed\u590d\u6838\u3002Nature\u53d1\u5e03\u4e00\u9879\u7814\u7a76\uff0c\u642d\u5efa\u9ad8\u5149\u8c31\u6210\u50cf\u7ed3\u5408\u6ce2\u6bb5\u7b5b\u9009\u3001\u6df1\u5ea6\u5b66\u4e60\u7684\u5b8c\u6574\n\u5206\u6790\u65b9\u6848\uff0c\u9488\u5bf9\u4e5d\u7c7b\u996e\u54c1\u6c61\u6e0d\u5f00\u5c55\u65e0\u635f\u9274\u522b\u5b9e\u9a8c\uff0c\u4e3a\u5211\u4fa6\u5fae\u91cf\u7269\u8bc1\u68c0\u6d4b\u63d0\u4f9b\u65b0\u601d\u8def\uff0c\u5f69\u8c31\u7ed3\u5408\u8be5\u7814\u7a76\uff0c\u548c\u5927\u5bb6\u804a\u804a\n\u9ad8\u5149\u8c31\u5728\u6cd5\u533b\u9886\u57df\u7684\u843d\u5730\u4ef7\u503c\u3002\u4e00\u3001\u4f20\u7edf\u7269\u8bc1\u68c0\u6d4b\u7684\u73b0\u5b58\u96be\u70b91. \u8089\u773c\u8bc6\u522b\u5c40\u9650\u5927\uff0c\u5496\u5561\u4e0e\u8336\u3001\u5a01...\n][64]\n[ \u5e94\u7528 ][65]\n[\n][66]\n[\n\n#### \u9ad8\u5149\u8c31\u76f8\u673a\u9009\u578b\u6307\u5357\uff1a\u4e0d\u540c\u573a\u666f\u4e0b\u7684\u5f69\u8c31\u4ea7\u54c1\u9002\u914d\u65b9\u6848\n\n2026-06-24\n\u9ad8\u5149\u8c31\u76f8\u673a\u54c1\u7c7b\u7e41\u591a\uff0c\u4ece\u5206\u5149\u65b9\u5f0f\u3001\u5149\u8c31\u8303\u56f4\u3001\u5206\u8fa8\u7387\u5230\u4ea7\u54c1\u5f62\u6001\uff0c\u5404\u9879\u53c2\u6570\u5dee\u5f02\u5de8\u5927\uff0c\u9009\u578b\u4e0d\u5f53\u4e0d\u4ec5\u4f1a\u9020\u6210\u9884\u7b97\n\u6d6a\u8d39\uff0c\u8fd8\u53ef\u80fd\u65e0\u6cd5\u6ee1\u8db3\u5b9e\u9645\u68c0\u6d4b\u9700\u6c42\u3002\u4e0d\u540c\u884c\u4e1a\u3001\u4e0d\u540c\u5e94\u7528\u573a\u666f\u5bf9\u9ad8\u5149\u8c31\u76f8\u673a\u7684\u8981\u6c42\u5404\u4e0d\u76f8\u540c\uff0c\u9700\u8981\u7ed3\u5408\u68c0\u6d4b\u76ee\u6807\n\u3001\u4f7f\u7528\u73af\u5883\u3001\u9884\u7b97\u8303\u56f4\u7b49\u56e0\u7d20\u7efc\u5408\u8003\u91cf\uff0c\u9009\u62e9\u771f\u6b63\u9002\u914d\u7684\u4ea7\u54c1\u3002\u4e00\u3001\u9ad8\u5149\u8c31\u76f8\u673a\u7684\u6838\u5fc3\u9009\u578b\u53c2\u6570\u5149\u8c31\u8303\u56f4\u662f\u9009\u578b\u65f6\n\u9996\u5148\u8981\u786e\u5b9a\u7684\u53c2\u6570\u3002\u53ef\u89c1\u5149\u6ce2\u6bb5\uff08400-700nm\uff09\u4e3b\u8981\u5bf9\u5e94\u4eba\u773c\u53ef\u89c1\u7684\u989c\u8272\u4fe1\u606f\uff0c\u9002\u5408\u989c\u8272\u5206\u7c7b\u3001\u8868...\n][67]\n[ \u5e94\u7528 ][68]\n[\n][69]\n[\n\n#### \u5149\u4f0f\u68c0\u6d4b\u8bbe\u5907\u9009\u578b\uff1a\u4ece\u4fbf\u643a\u5230\u5b9e\u9a8c\u5ba4\u7684\u5f69\u8c31EL/PL\u4ea7\u54c1\u89e3\u6790\n\n2026-06-24\n\u5149\u4f0f\u884c\u4e1a\u7684\u68c0\u6d4b\u9700\u6c42\u8986\u76d6\u751f\u4ea7\u5236\u9020\u3001\u7535\u7ad9\u8fd0\u7ef4\u3001\u6280\u672f\u7814\u53d1\u7b49\u591a\u4e2a\u573a\u666f\uff0c\u4e0d\u540c\u573a\u666f\u5bf9EL/PL\u68c0\u6d4b\u8bbe\u5907\u7684\u529f\u80fd\u3001\u5f62\u6001\u3001\n\u7cbe\u5ea6\u8981\u6c42\u5dee\u5f02\u663e\u8457\u3002\u4ece\u53e3\u888b\u5927\u5c0f\u7684\u4fbf\u643a\u8bbe\u5907\u5230\u5927\u578b\u5b9e\u9a8c\u5ba4\u68c0\u6d4b\u7cfb\u7edf\uff0c\u5404\u7c7b\u8bbe\u5907\u5404