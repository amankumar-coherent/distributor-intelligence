            "text": "NCERT\n\nclick to know more.\n\n-->\n\n\u092e\u0941\u0916\u094d\u092f \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092a\u0930 \u091c\u093e\u090f\u0901 |\n\n\u0928\u0947\u0935\u093f\u0917\u0947\u0936\u0928 \u092a\u0930 \u091c\u093e\u090f\u0901 |\n\n\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u090f\u0915\u094d\u0938\u0947\u0938 |\n\n\u091f\u0947\u0915\u094d\u0938\u091f \u0915\u093e \u0938\u093e\u0907\u091c\u093c:\n\u0906- | \u0906| \u0906+\n\n\u0938\u093e\u0907\u091f \u0926\u0943\u0936\u094d\u092f:\nA A\n\nEnglish\n\nHindi\n\nNCERT\n\n\u0939\u094b\u092e (current)\n\n\u0939\u092e\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902\n\n\u0939\u092e\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902\n\u092a\u094d\u0930\u092c\u0902\u0927\u0928\n\u0935\u0930\u093f\u0937\u094d\u0920 \u092a\u0926\u093e\u0927\u093f\u0915\u093e\u0930\u0940\n\u0938\u0942\u091a\u0928\u093e \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0905\u0927\u093f\u0928\u093f\u092f\u092e \u0915\u0947\n\u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u092a\u094d\u0930\u0915\u091f\u0940\u0915\u0930\u0923\n\n\u0938\u0902\u0918\u091f\u0915 \u0914\u0930 \u0935\u093f\u092d\u093e\u0917\n\n\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f\n\u0936\u093f\u0915\u094d\u0937\u093e \u0938\u0902\u0938\u094d\u0925\u093e\u0928\n\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093f\u092f\n\u0936\u093f\u0915\u094d\u0937\u093e \u0938\u0902\u0938\u094d\u0925\u093e\u0928\n\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0936\u0948\u0915\u094d\u0937\u093f\u0915 \u092a\u094d\u0930\u094c\u0926\u094d\u092f\u094b\u0917\u093f\u0915\u0940 \u0938\u0902\u0938\u094d\u0925\u093e\u0928\n\u092a\u0902\u0921\u093f\u0924 \u0938\u0941\u0902\u0926\u0930\u0932\u093e\u0932\n\u0936\u0930\u094d\u092e\u093e \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0936\u093f\u0915\u094d\u0937\u093e \u0938\u0902\u0938\u094d\u0925\u093e\u0928\n\u092a\u0930\u0916\n\n\u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e\n\n\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f\n\u092a\u094d\u0930\u0924\u093f\u092d\u093e \u0916\u094b\u091c \u092a\u0930\u0940\u0915\u094d\u0937\u093e\n\u0905\u0916\u093f\u0932\n\u092d\u093e\u0930\u0924\u0940\u092f \u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f\u0940 \u0936\u093f\u0915\u094d\u0937\u093e \u0938\u0930\u094d\u0935\u0947\u0915\u094d\u0937\u0923\n\u0905\u0927\u094d\u092f\u093e\u092a\u0915 \u0928\u0935\u093e\u091a\u093e\u0930\n\u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930\n\u0930\u093e\u0937\u094d\u200d\u091f\u094d\u0930\u0940\u092f\n\u092c\u093e\u0932 \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928\u0940\n\u092e\u0940\u0921\u093f\u092f\u093e \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e\n\u0905\u0928\u0941\u0938\u0902\u0927\u093e\u0928 \u0905\u0928\u0941\u0926\u093e\u0928\n(\u090f\u0930\u093f\u0915)\n\u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e\n\u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0938\u092e\u093f\u0924\u093f\n\n\u0917\u0948\u0932\u0930\u0940\n\n\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0936\u093f\u0915\u094d\u0937\u093e \u0928\u0940\u0924\u093f - 2020 \u0915\u093e \u0915\u093e\u0930\u094d\u092f\u093e\u0928\u094d\u0935\u092f\u0928\n\n\u0905\u0902\u0924\u0930\u094d\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092f\u094b\u0917\n\u0926\u093f\u0935\u0938\n\u0915\u0932\u093e \u0909\u0924\u094d\u0938\u0935\n\u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0926\u093f\u0935\u0938\n\u0908-\u0930\u0915\u094d\u0937\u093e \u0915\u093e \u0936\u0941\u092d\u093e\u0930\u0902\u092d\n\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0914\u0930 \u0915\u0932\u094d\u092f\u093e\u0923\n\u0906\u0930\u092c\u0940\u0935\u0940\u092a\u0940 \u0917\u0948\u0932\u0930\u0940\n\n\u092a\u094d\u0930\u0915\u093e\u0936\u0928\n\n\u092a\u094d\u0930\u0915\u093e\u0936\u0928\u094b\u0902 \u0915\u0940 \u0938\u0942\u091a\u0940\n\u0908-\u092a\u092c\n\u092b\u094d\u0932\u093f\u092a\u092c\u0941\u0915\n\u092a\u0940\u0921\u0940\u090f\u092b (\u0915\u0915\u094d\u0937\u093e 1-12)\n\u0930\u093e\u091c\u094d\u092f / \u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u093e\u0938\u093f\u0924 \u092a\u094d\u0930\u0926\u0947\u0936 \u0908-\u092a\u0941\u0938\u094d\u0924\u0915 (\u0908-\u092a\u092c)\n\u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0936\u093f\u0915\u094d\u0937\u093e\n\u0938\u0940\u0938\u0940\u0908 \u092a\u0948\u0915\u0947\u091c\n\n\u092c\u094d\u0930\u093f\u091c \u0915\u094b\u0930\u094d\u0938 \u092a\u0948\u0915\u0947\u091c\n\u092c\u0930\u0916\u093e \u0936\u0943\u0902\u0916\u0932\u093e\n\n\u0905\u0928\u094d\u092f \u092a\u094d\u0930\u0915\u093e\u0936\u0928\n\u092a\u0924\u094d\u0930\u093f\u0915\u093e\u090f\u0901 \u0914\u0930 \u0906\u0935\u0927\u093f\u0915 \u092a\u094d\u0930\u0915\u093e\u0936\u0928\n\u0905\u092e\u0941\u0926\u094d\u0930\u093f\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940\n\u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u0942\u091a\u0928\u093e\n\u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u0940 \u092a\u0941\u0938\u094d\u0924\u0915\u0947\u0902\n\n\u0928\u092e\u0942\u0928\u093e \u092a\u094d\u0930\u0936\u094d\u0928 \u092a\u0924\u094d\u0930\n\u092a\u0941\u0938\u094d\u0924\u0915 \u0915\u094d\u0930\u092f \u092a\u094d\u0930\u092a\u0924\u094d\u0930\n\u0938\u094d\u0915\u0942\u0932 \u0915\u093f\u091f\n\u0909\u0926\u093e\u0939\u0930\u0923\u093e\u0924\u094d\u092e\u0915 \u0938\u092e\u0938\u094d\u092f\u093e\u090f\u0901\n\u092a\u094d\u0930\u092f\u094b\u0917\u0936\u093e\u0932\u093e \u092a\u0941\u0938\u094d\u0924\u093f\u0915\u093e\u090f\u0901\n\u090f\u0928\u0938\u0940\u0908\u0906\u0930\u091f\u0940 \u0915\u0947 50 \u0935\u0930\u094d\u0937\n\u092a\u0930\u093f\u0923\u093e\u092e \u0930\u0942\u092a\u0930\u0947\u0916\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\n\n\u0924\u094d\u0930\u093f\u092d\u093e\u0937\u0940 \u0936\u092c\u094d\u0926\u0915\u094b\u0936\n\u092a\u094d\u0930\u094c\u095d \u0936\u093f\u0915\u094d\u0937\u093e\n\u091c\u093e\u0926\u0941\u0908 \u092a\u093f\u091f\u093e\u0930\u093e\n\u0935\u093f\u0936\u0947\u0937 \u092e\u0949\u0921\u094d\u092f\u0942\u0932\n\u092d\u093e\u0930\u0924\u0940\u092f \u092d\u093e\u0937\u093e\u0913\u0902 \u092e\u0947\u0902 \u092a\u094d\u0930\u0935\u0947\u0936\u093f\u0915\u093e\u090f\u0901\n\u0938\u094d\u0915\u0942\u0932 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0915\u0930\u093f\u092f\u0930 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u093f\u0915\u093e\n\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0938\u092e\u093f\u0924\u093f (\u090f\u0938\u090f\u092e\u0938\u0940)\n\n\u0918\u094b\u0937\u0923\u093e\u090f\u0902\n\n\u0930\u093f\u0915\u094d\u0924\u093f\u092f\u093e\u0901\n\u0928\u093f\u0935\u093f\u0926\u093e\u090f\u0901\n\u0938\u0942\u091a\u0928\u093e\u090f\u0901\n\u0905\u0928\u094d\u092f \u0918\u094b\u0937\u0923\u093e\u090f\u0901\n\u0938\u0902\u0917\u094b\u0937\u094d\u0920\u0940 / \u0938\u092e\u094d\u092e\u0947\u0932\u0928 / \u0915\u093e\u0930\u094d\u092f\u0936\u093e\u0932\u093e\n\u0938\u092e\u093e\u091a\u093e\u0930\u094b\u0902 \u092e\u0947\u0902 \u090f\u0928\u0938\u0940\u0908\u0906\u0930\u091f\u0940\n\n\u0938\u0902\u092a\u0930\u094d\u0915\n\n\u0938\u0902\u092a\u0930\u094d\u0915\n\u091c\u0928 \u0938\u0942\u091a\u0928\u093e\n\u0905\u0927\u093f\u0915\u093e\u0930\u0940\n\u0926\u0942\u0930\u092d\u093e\u0937 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0915\u093e\n\n&times;\n\nVisit Website\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n-->\n\n\u0905\u0926\u094d\u092f\u0924\u0928 \u091c\u093e\u0928\u0915\u093e\u0930\u0940\n\n&nbsp; NCERT Press Release regarding Class 9 