      "discovery_source": "ddgs_bing",
      "enrichment_source": "smart_crawl",
      "website": "runlaminar.com",
      "is_seed": false,
      "company_function": "manufacturer",
      "company_summary": "Runlaminar specializes in advanced spectral sensors and machine learning solutions designed to optimize manufacturing processes, particularly within the food and beverage industry. Their core offerings include AI-powered solutions for Clean-in-Place (CIP) optimization, product changeover efficiency, batch and line optimization, and real-time quality analysis, all aimed at enhancing operational efficiency, reducing waste, and ensuring product consistency. With a focus on delivering substantial savings and improved performance, Runlaminar serves a diverse range of sectors including food and beverage, flavor and fragrance, brewing, health and beauty, and consumer packaged goods.",
      "operational_presence": "Not stated on website",
      "data_sources": "discovery=ddgs_bing | enrichment=smart_crawl | page=https://runlaminar.com",
      "_crawl": {
        "founded_year": 2021,
        "headquarters": "Somerville, MA, United States",
        "contact_address": "444 Somerville Ave., Somerville, MA 02143, United States",
        "offices": "",
