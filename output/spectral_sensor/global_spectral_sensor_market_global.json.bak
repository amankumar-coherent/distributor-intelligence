3f\u0915 \u0938\u092e\u094d\u092a\u094d\u0930\u0947\u0937\u0923 \u092a\u094d\u0930\u0924\u093f\u092f\u094b\u0917\u093f\u0924\u093e || \u0906\u0935\u0947\u0926\u0928 \u0915\u0940 \u0905\u0902\u0924\u093f\u092e \u0924\u093f\u0925\u093f 28.06.2022 \u0924\u0915 \u092c\u0922\u093c\u093e\u0908 \u0917\u0908&nbsp;&nbsp; | &nbsp-->\n\n\u090f\u0928\u0938\u0940\u0908\u0906\u0930\u091f\u0940 \u0915\u0940 \u0905\u0928\u0941\u0938\u0902\u0927\u093e\u0928 \u090f\u0938\u094b\u0938\u093f\u090f\u091f\u0936\u093f\u092a || &nbsp;\u0911\u0928\u0932\u093e\u0907\u0928 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0947\u0902 -->\n\u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u0914\u0930 \u092a\u0930\u093e\u092e\u0930\u094d\u0936 \u092e\u0947\u0902 \u0921\u093f\u092a\u094d\u0932\u094b\u092e\u093e \u092a\u093e\u0920\u094d\u092f\u0915\u094d\u0930\u092e 2022 | \u0911\u0928\u0932\u093e\u0907\u0928 \u0906\u0935\u0947\u0926\u0928 \u0915\u0930\u0947\u0902 |&nbsp;-->\n\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0936\u0948\u0915\u094d\u0937\u093f\u0915 \u0905\u0928\u0941\u0938\u0902\u0927\u093e\u0928 \u0914\u0930 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u092a\u0930\u093f\u0937\u0926 \u0915\u0947 \u0938\u091a\u093f\u0935 \u092a\u0926 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 |&nbsp; -->\n\u0938\u0940\u0908\u0908 -2021 | &nbsp-->\nCondolence meeting of Lt. Prof. A D Tiwari | &nbsp -->\n\u0935\u093f\u0926\u094d\u092f\u093e \u0926\u093e\u0928 3.0 | &nbsp-->\n\u092a\u0930\u093f\u0915\u094d\u0937\u093e \u092a\u0947 \u091a\u0930\u091a\u093e 2021 | &nbsp-->\n\u0915\u094b\u0935\u093f\u0921-19 \u0905\u092d\u093f\u092f\u093e\u0928 | &nbsp-->\n\n\u090f\u0928\u0938\u0940\u0908\u0906\u0930\u091f\u0940 \u0938\u0902\u0918\u091f\u0915 \u0907\u0915\u093e\u0907\u092f\u093e\u0901\n\n\u090f\u0928\u0906\u0908\u0908\n\u0938\u093e\u0907\u091f \u0926\u0947\u0916\u0947\u0902 \u0905\u0935\u0938\u094d\u0925\u093f\u0924\u093f&nbsp; \u092a\u0924\u0