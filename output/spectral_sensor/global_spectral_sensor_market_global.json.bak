rature-sensors\n[42]: https://ams-osram.com/products/sensor-solutions/x-ray-sensors\n[43]: https://ams-osram.com/products/interfaces\n[44]: https://ams-osram.com/products/interfaces\n[45]: https://ams-osram.com/products/interfaces/sensor-interfaces\n[46]: https://ams-osram.com/products/asics\n[47]: https://ams-osram.com/products/full-service-foundry\n[48]: https://ams-osram.com/products/lamps\n[49]: https://ams-osram.com/products/lamps\n[50]: https://ams-osram.com/products/lamps/automotive-lamps\n[51]: https://ams-osram.com/products/boards-kits-accessories\n[52]: https://ams-osram.com/products/product-families\n[53]: https://ams-osram.com/applications\n[54]: https://ams-osram.com/applications\n[55]: https://ams-osram.com/applications/automotive-mobility\n[56]: https://ams-osram.com/applications/automotive-mobility\n[57]: https://ams-osram.com/applications/automotive-mobility/application-block-diagrams\n[58]: https://ams-osram.com/applications/automotive-mobility/exterior-lighting\n[59]: https://ams-osram.com/applications/automotive-mobility/headlights\n[60]: https://ams-osram.com/applications/automotive-mobility/adaptive-driving-beam\n[61]: https://ams-osram.com/applications/automotive-mobility/daytime-running-lights\n[62]: https://ams-osram.com/applications/automotive-mobility/side-marker-turn-indicator\n[63]: https://ams-osram.com/applications/automotive-mobility/rear-combination-light\n[64]: https://ams-osram.com/applications/automotive-mobility/ground-illumination\n[65]: https://ams-osram.com/applications/automotive-mobility/intelligent-signal-display\n[66]: https://ams-osram.com/applications/automotive-mobility/car-body-illumination\n[67]: https://ams-osram.com/applications/automotive-mobility/exterior-sensing\n[68]: https://ams-osram.com/applications/automotive-mobility/exterior-sensing-for-adas-ad\n[69]: https://ams-osram.com/applications/automotive-mobility/rain-light-tunnel-sensing\n[70]: https://ams-osram.com/applications/automotive-mobility/interior-lighting-sensing\n[71]: https://ams-osram.com/applications/automotive-mobility/ambient-lighting\n[72]: https://ams-osram.com/applications/automotive-mobility/functional-illumination\n[73]: https://ams-osram.com/applications/automotive-mobility/display-backlighting\n[74]: https://ams-osram.com/applications/automotive-mobility/projection\n[75]: https://ams-osram.com/applications/automotive-mobility/smart-surface\n[76]: https://ams-osram.com/applications/automotive-mobility/ambient-light-sensing\n["
