          "company": {
            "name": "8KBET",
            "legal_name": "8KBET",
            "description": "8KBET is a multi-platform online betting brand that offers a wide range of products including sports betting, live casino, slot games, 3D fish shooting, cockfighting, and lottery. The platform is designed to provide a seamless experience on both website and mobile applications, catering to the entertainment needs of players in the Asian market, particularly in Vietnam.",
            "tagline": "Multi-platform online betting focused on modern gaming and entertainment experiences.",
