      "data_sources": "discovery=ddgs_bing | enrichment=smart_crawl | page=https://healthgenesis.com",
      "_crawl": {
        "founded_year": 1998,
        "headquarters": "4131 SW 47th Ave Suite 1404, Davie, FL 33314",
        "contact_address": "4131 SW 47th Ave Suite 1404, Davie, FL 33314",
        "offices": "",
