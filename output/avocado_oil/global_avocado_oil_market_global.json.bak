      "company_summary": "",
      "operational_presence": "Superior Product [Front-Tek Elegant Design][Front-Tek Elegant Design] Available in 80+ colors, the range of creativity is virtually limitless.; It\u2019s extremely hard, lightweight, and long-lasting.\\nSuperior Product\\n[Front-Tek Elegant Design][Front-Tek Elegant Design]\\nAvailable in 80+ colors, the...",
      "data_sources": "discovery=ddgs_bing | enrichment=smart_crawl | page=https://frontek-usa.com",
      "_crawl": {
        "founded_year": 1940,
        "headquarters": "1695 Curtiss Court, La Verne, CA 91750",
        "contact_address": "1695 Curtiss Court, La Verne, CA 91750",
        "offices": "",
        "manufacturing_locations": "",
        "regions_served": "",
        "countries": "USA",
        "ownership_parent": "",
        "company_type": "Private",
        "employee_count": "",
