# =============================================================================
# Vendor Intelligence — copy to .env (never commit .env)
# =============================================================================

# -----------------------------------------------------------------------------
# Kompass global distributor scraper (run_cursor_expand.py --backend kompass)
# vendor_intel.discovery.kompass_distributors / kompass_ai_search /
# vendor_intel.clients.kompass — see docs on the scraper module docstrings.
# -----------------------------------------------------------------------------
# AI provider used ONLY to locate the correct Kompass market/product page and
# assist distributor verification — never to invent company data. Falls back
# to AI_FALLBACK_PROVIDER if the primary provider errors or finds nothing
# verifiable. Reuses the SAME provider keys as LLM_PROVIDER below
# (GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY) — "deepseek" is an
# alias that routes through OPENAI_API_KEY + OPENAI_BASE_URL pointed at
# DeepSeek's endpoint, same convention as the rest of this repo.
AI_SEARCH_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai
# DEEPSEEK_API_KEY=PASTE_YOUR_KEY_HERE
# (Or point OPENAI_API_KEY/OPENAI_BASE_URL at DeepSeek — see chatgpt_expand docs.)

KOMPASS_SCRAPER_ENABLED=true
# 0 = no upper limit on Kompass distributor discovery (paginate until genuinely
# out of pages). Set a positive number to cap it.
MAX_COMPANIES_PER_MARKET=0
# Floor for TOTAL verified distributors per market. If Kompass alone doesn't
# reach this, `run_cursor_expand.py --backend kompass` automatically falls
# back to the ChatGPT/DeepSeek expand pipeline (same steps as --backend
# chatgpt) to top up the remainder into the SAME final Excel.
MIN_COMPANIES_PER_MARKET=500
MIN_DISTRIBUTOR_CONFIDENCE=65
REQUEST_DELAY_SECONDS=2
MAX_RETRIES=3
GLOBAL_SEARCH=true
KOMPASS_CACHE_ENABLED=true
# KOMPASS_CACHE_DIR=data/kompass_cache
# KOMPASS_CACHE_TTL_SEC=1209600

# Optional: Neon / PostgreSQL (scripts/fetch_neon_db.py)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# LIVE runs (run_query.py / run_pipeline.py): set USE_MOCK_DATA=false and one LLM key.
USE_MOCK_DATA=false

# Pick ONE provider:
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=PASTE_YOUR_KEY_HERE
# Faster/cheaper than Sonnet for 130-company classify runs:
COMPILER_MODEL=claude-haiku-4-5-20251001
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# Phase 1 market understanding only (large value-chain JSON) — use Sonnet
MARKET_MAP_MODEL=claude-sonnet-4-6
# LLM_PROVIDER=opencode
# OPENCODE_API_KEY=PASTE_YOUR_KEY_HERE
# OPENCODE_MODEL=deepseek-v4-flash-free
# When LLM_PROVIDER=anthropic but quota is hit, fall back to OpenCode if key is set:
# LLM_FALLBACK_TO_OPENCODE=true
# LLM_PROVIDER=chatgpt_scraper — free, no API key, but plain-text only (no
# JSON mode) and ~10-30s/call via a real Chrome launch. Only usable for
# llm_complete() call sites, not llm_complete_json(). Also requires
# CHATGPT_SCRAPER_ENABLED=true (see the chatgpt_scraper section below).

PIPELINE_PROFILE=quality
# Channel Partner Intelligence (default on). false = full manufacturer landscape.
CHANNEL_PARTNER_MODE=true

# Higher volume (global) — defaults: discover/enrich 280, export 240 rows
# Japan/regional — defaults: discover/enrich 250, export 200 rows
# PIPELINE_GLOBAL_DISCOVER_MAX=280
# PIPELINE_GLOBAL_ENRICH_MAX=280
# PIPELINE_GLOBAL_EXPORT_MAX_ROWS=240
# PIPELINE_DISCOVER_MAX=250
# PIPELINE_EXPORT_MAX_ROWS=200
# TARGET_UNIQUE_COMPANIES=280
# DISCOVERY_YIELD_MIN_UNIQUE=200

SKIP_DDGS=false
SKIP_BING_HTML=false
RESULTS_PER_QUERY=25
# Search stability (rate limits / large lists)
# DDG_REQUEST_DELAY_MIN=2
# DDG_REQUEST_DELAY_MAX=5
# DDGS_SEARCH_RETRIES=3
# DDGS_RETRY_DELAY_MIN=10
# DDGS_RETRY_DELAY_MAX=30
# DDG_WORKER_MAX=2
# SEARCH_MAX_WORKERS=2
# DDGS_BACKENDS=bing,duckduckgo,brave,yandex,google
# SEARCH_DISK_CACHE=true
# GAP_FILL_BATCH_SIZE=100
# GAP_FILL_BATCH_PAUSE_SEC=300
# GAP_FILL_CONCURRENT=2
# Phase 2 discovery: parallel prompt searches (requires DDG_WORKER_COUNT>0)
# DISCOVERY_PARALLEL_BATCH=4
DDGS_BACKENDS=bing,duckduckgo,brave,yandex,google
WIKIDATA_ENABLED=true
WEB_FETCH_ENABLED=true

# --- MOCK demo only (empty results) ---
# USE_MOCK_DATA=true

# -----------------------------------------------------------------------------
# LIVE MODE — copy env.live.template into .env and fill PASTE_* values
# -----------------------------------------------------------------------------
# USE_MOCK_DATA=false
# LLM_PROVIDER=opencode
# OPENCODE_API_KEY=paste-from-https://opencode.ai/zen
# OPENCODE_MODEL=nemotron-3-super-free
# Same OPENCODE_API_KEY works for all Zen free models (no new key to switch model).
# deepseek-v4-flash-free often rejects response_format — prefer nemotron or big-pickle.
# SMART_CRAWL_USE_JSON_SCHEMA=false
# SMART_CRAWL_USE_JSON_SCHEMA=false
# Optional: real OpenAI for crawls only (better extraction):
# OPENAI_API_KEY=paste-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Or: LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY=paste-from-console.anthropic.com
MAX_LLM_CALLS_PER_RUN=1

# Quality pipeline (~20 min, 25-65 vetted rows) — default:
# PIPELINE_PROFILE=quality
# PIPELINE_USE_SSC=true
# PIPELINE_DISCOVER_MAX=70
# PIPELINE_ENRICH_MAX=50
# PIPELINE_MIN_EXPORT_CONFIDENCE=0.45
#
# Higher volume when run_pipeline.py --country global (auto, no --recall):
# PIPELINE_GLOBAL_DISCOVER_MAX=110
# PIPELINE_GLOBAL_ENRICH_MAX=80
# PIPELINE_GLOBAL_EXPORT_MIN_ROWS=50
# PIPELINE_GLOBAL_EXPORT_MAX_ROWS=95
# PHASE1_GLOBAL_SMOKE_MAX_PROMPTS=10
# PHASE1_GLOBAL_DISCOVERY_PROMPTS=20
# PIPELINE_GLOBAL_VOLUME_PROMPT_COUNT=36
#
# Broad / noisy export:
# PIPELINE_RECALL_MODE=true
# Or: run_pipeline.py --recall
#
# Slower deep crawl (not SSC):
# run_pipeline.py --full-crawl

# -----------------------------------------------------------------------------
# Free search — DDGS → Bing HTML → SearXNG (no paid API keys)
# -----------------------------------------------------------------------------
SEARCH_PRIMARY=duckduckgo
SEARCH_BACKUP=searxng
SKIP_DDGS=false
SKIP_BING_HTML=false
PREFER_SEARXNG=false
# deedy5/ddgs text() backends — no startpage/auto (WinError 10061 on some networks)
# https://github.com/deedy5/ddgs#engines
DDGS_BACKENDS=duckduckgo,bing,brave,mojeek,google
# Proxy pipeline (run once):  python scripts/check_proxies.py
# USE_PROXY_POOL=true
# DDGS_USE_PROXY_POOL=true
# DDGS_ALLOW_DIRECT=false
# DDGS_AUTO_PROXY=false
# PROXY_POOL_CACHE=output/proxy_pool_verified.json
# PROXY_MAX_CHECK=40
# Optional: DDGS_PROXY=  DDGS_VERIFY=true  DDGS_NEWS_BACKENDS=bing,duckduckgo,yahoo
SEARCH_USE_FALLBACKS=true
SEARXNG_BASE_URL=http://127.0.0.1:8080
# Large batch runs: start extra local instances (docker compose --profile batch-scale up -d)
# then list them here (comma-separated) so search_router.py can spread load / fail over.
# SEARXNG_EXTRA_URLS=http://127.0.0.1:8081,http://127.0.0.1:8082
MIN_RESULTS_BEFORE_BACKUP=3
RESULTS_PER_QUERY=25

# -----------------------------------------------------------------------------
# Google Alerts — backend article collector (no Google API)
# Best: paste RSS URLs from https://www.google.com/alerts (RSS icon per alert)
# Optional: Selenium + Chrome profile for auto-discovering RSS feeds
# -----------------------------------------------------------------------------
GOOGLE_ALERTS_ENABLED=false
# Comma-separated RSS feed URLs (recommended — works without browser)
# GOOGLE_ALERTS_RSS_URLS=https://www.google.com/alerts/feeds/xxxxx/yyyyy
GOOGLE_ALERTS_PROFILE_PATH=data/chrome-profile
GOOGLE_ALERTS_HEADLESS=false
GOOGLE_ALERTS_STORE_PATH=data/alerts/articles.json

# -----------------------------------------------------------------------------
# Optional RSS (comma-separated URLs)
# -----------------------------------------------------------------------------
# RSS_FEED_URLS=

# -----------------------------------------------------------------------------
# Enrichment — free
# -----------------------------------------------------------------------------
# Wikidata = free open data (NO API key). Used in gap-fill for founded/HQ/website/industry.
WIKIDATA_ENABLED=true
# WIKIDATA_SPARQL_DELAY_SEC=1.0
WEB_FETCH_ENABLED=true

# Company website scraping — ddgs.extract() (https://pypi.org/project/ddgs/)
SCRAPE_BACKEND=ddgs
SCRAPE_EXTRACT_FMT=text_markdown
SELENIUM_HEADLESS=true
SELENIUM_PAGE_LOAD_TIMEOUT=25
SELENIUM_IMPLICIT_WAIT=3
SELENIUM_SCROLL_PAUSE=0.6
# CHROME_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# -----------------------------------------------------------------------------
# CSV output
# -----------------------------------------------------------------------------
CSV_OUTPUT_ENABLED=true
CSV_OUTPUT_DIR=output
# Demo / CEO CSV exports from run_query.py (default: output/demo)
MARKET_QUERY_OUTPUT_DIR=output/demo

# -----------------------------------------------------------------------------
# Tuning — discovery & output volume
# -----------------------------------------------------------------------------
RESULTS_PER_QUERY=25
MAX_VALIDATION_ENTITIES=60
TARGET_SOLID_COMPANIES=30

# -----------------------------------------------------------------------------
# Phase 3 — fast validation (default: on)
# -----------------------------------------------------------------------------
PHASE3_FAST_VALIDATION=true
PHASE3_PARALLEL_WORKERS=3
PHASE3_MAX_HITS_PER_QUERY=3
# DDG news.js often rate-limits — leave false
DDG_NEWS_API=false

# -----------------------------------------------------------------------------
# Paid APIs — NOT used in free-first plan (leave commented)
# -----------------------------------------------------------------------------
# SERPAPI_API_KEY=
# (Brave/Serper paid APIs removed — use DDGS + Bing HTML + SearXNG)
# TAVILY_API_KEY=
# NEWSAPI_API_KEY=
# GNEWS_API_KEY=
# CLEARBIT_API_KEY=
# FIRECRAWL_API_KEY=
# Apollo.io — contact person search (master API key, x-api-key header)
# APOLLO_API_KEY=

# -----------------------------------------------------------------------------
# Agent Reach (../Agent-Reach-main) — Jina + optional Exa semantic search
# -----------------------------------------------------------------------------
# AGENT_REACH_ENABLED=true
# AGENT_REACH_EXA_SEARCH=true
# AGENT_REACH_LINKEDIN_MCP=true
# AGENT_REACH_ROOT=C:\Users\aman.kumar\Desktop\Cmi\Agent-Reach-main
# Delay between LinkedIn MCP calls (seconds) — raise if LinkedIn blocks/rate-limits
# LINKEDIN_MCP_DELAY_SEC=4.0
# LINKEDIN_MCP_DELAY_JITTER=1.5
# Exa setup (one-time): npm install -g mcporter && mcporter config add exa https://mcp.exa.ai/mcp
# LinkedIn MCP setup (one-time):
#   pip install linkedin-scraper-mcp
#   linkedin-scraper-mcp --login --no-headless
#   linkedin-scraper-mcp --transport streamable-http --port 8001
#   mcporter config add linkedin http://localhost:8001/mcp
# Doctor: python scripts/agent_reach_doctor.py

# -----------------------------------------------------------------------------
# ChatGPT web-UI scraper (unofficial, vendor_intel.scraping.chatgpt_scraper)
# Uses the same Selenium + Google Chrome install as WEB_FETCH_ENABLED above —
# no extra deps needed. Prefer OPENAI_API_KEY / the openai client for anything
# programmatic — this is only for tasks that specifically require the ChatGPT
# web app itself.
# Runs ANONYMOUS/guest by default (free, no login) — Google-account login does
# not reliably work here (Google blocks OAuth sign-in from any
# WebDriver-controlled browser). Only try a persisted/logged-in profile if
# your OpenAI account has an email+password login.
# -----------------------------------------------------------------------------
CHATGPT_SCRAPER_ENABLED=false
# CHATGPT_SCRAPER_CHROME_PROFILE_DIR=C:\path\to\chrome-profile

# -----------------------------------------------------------------------------
# Market expand CLI (run_cursor_expand.py)
# -----------------------------------------------------------------------------
# Default --backend chatgpt uses OPENAI_API_KEY (ChatGPT SDK) to extract + fill columns.
#   .\.venv\Scripts\python.exe run_cursor_expand.py --backend chatgpt --query "Global Avocado Oil Market" --batch all --target 320
# OPENAI_MODEL=gpt-4o-mini
# Cost dashboard (after/during runs):
#   .\.venv\Scripts\python.exe show_cost.py
#   .\.venv\Scripts\python.exe -m streamlit run cost_dashboard.py
# Optional rate overrides (USD per 1M tokens):
# OPENAI_USD_PER_1M_INPUT=0.15
# OPENAI_USD_PER_1M_OUTPUT=0.60

#
# Optional Cursor SDK agent (--backend cursor):
# Create key: https://cursor.com/dashboard → Integrations / API Keys
# CURSOR_API_KEY=crsr_YOUR_KEY_HERE
# CURSOR_EXPAND_MODEL=composer-2.5



# --- Google AI Mode scraper (vendor_intel.scraping.google_ai_mode) ---
# Free generative backend for the market-research pipeline. Runs ANONYMOUSLY
# (no Google account/login needed) via Patchright, a stealth-patched
# Playwright fork — plain playwright gets instantly CAPTCHA'd here.
GOOGLE_AI_MODE_ENABLED=true
# Set false to watch the browser work (useful for solving a rare CAPTCHA).
GOOGLE_AI_MODE_HEADLESS=false
# Seconds to wait between AI Mode queries (jitter is added on top).
# Google throttles by request RATE per IP: firing queries back-to-back
# triggered "Our systems have detected unusual traffic" ~200 companies into
# a long run, and the CAPTCHA it then serves often won't even load, so it
# can't be solved by hand. Raise this if you keep getting blocked; set 0 to
# disable pacing entirely (faster, much likelier to be blocked).
# GOOGLE_AI_MODE_QUERY_DELAY=30
# Which browser build to drive: "chrome" (default, STRONGLY recommended)
# or "chromium" (Playwright's bundled build).
# Measured on this machine: real Chrome answers AI Mode with no CAPTCHA,
# while Chromium got CAPTCHA'd on nearly every query - its fingerprint is
# far easier for Google to detect. Chromium is NOT needed to load
# extensions: real Chrome loads an unpacked extension fine, as long as the
# automation profile is CREATED with the extension already configured
# (delete the profile dir after adding GOOGLE_AI_MODE_EXTENSIONS).
# GOOGLE_AI_MODE_BROWSER=chrome
# Automation profile location. Defaults to data/ai_mode_chrome_profile.
# Do NOT point this at your real Chrome "User Data" folder: Chrome locks a
# profile to one process (so you couldn't browse), and an
# organization-managed Chrome blocks automation against it entirely
# (verified — the launch hangs indefinitely with no error).
# GOOGLE_AI_MODE_PROFILE_DIR=C:\path\to\automation-profile
# Seed the automation profile from your REAL Chrome profile on FIRST use
# only (copies Cookies/History/Web Data/Preferences/Network). This is the
# supported way to get your real browsing signals into the scraper without
# driving the live profile. Delete the automation profile dir to re-seed.
# CHATGPT_SCRAPER_CHROME_PROFILE_DIR=C:\Users\<you>\AppData\Local\Google\Chrome\User Data
# CHATGPT_SCRAPER_CHROME_PROFILE_DIRECTORY=Default
#
# Load unpacked Chrome extension(s) into the automation browser. Separate
# multiple paths with ";" (not ":", since Windows paths contain colons).
# Each path must be the folder that DIRECTLY contains manifest.json — an
# "extension/" subfolder is auto-detected, but a repo root with the
# manifest deeper than that silently loads nothing.
# Mainly intended for a CAPTCHA solver, so long runs don't need a human.
# CAVEAT (verified on this machine): an organization-managed Chrome can
# silently refuse sideloaded/unpacked extensions even with the correct
# flags. The scraper checks for a registered background worker after
# launch and logs a WARNING if nothing loaded, so check the logs rather
# than assuming the extension is active.
# GOOGLE_AI_MODE_EXTENSIONS=C:\path\to\extension-folder
